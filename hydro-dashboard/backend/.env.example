# คัดลอกเป็น .env แล้วใส่ค่าจริง (ไฟล์นี้ห้าม commit และห้ามส่งในแชท)

# --- HiveMQ Cloud (Console -> Cluster -> Overview / Access Management) ---
# ใช้พอร์ต 8883 (TLS) เท่านั้น
HIVEMQ_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
HIVEMQ_USERNAME=bridge
HIVEMQ_PASSWORD=xxxxxxxx

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key: ใช้ในเซิร์ฟเวอร์นี้เท่านั้น ห้ามใส่ในหน้าเว็บ ห้าม commit
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# --- ตัวเลือก (มีค่าเริ่มต้น) ---
TOPIC_PREFIX=hydro
# บันทึก sensor_logs ได้ไม่ถี่กว่านี้ต่ออุปกรณ์ (วินาที) ลดจำนวนครั้งที่ webhook ถูกยิง (0 = ไม่จำกัด)
MIN_INSERT_INTERVAL_SEC=30
# คำสั่งควบคุมที่ไม่มี ack ภายในเวลานี้จะถูกตั้งเป็น expired
COMMAND_TTL_SEC=30
# ไม่ได้ยินจากอุปกรณ์เกินเวลานี้ = ออฟไลน์
OFFLINE_AFTER_SEC=120

# --- รูปแบบ topic ของทีมเฟิร์มแวร์ (farm/waterlevel|light|ph/data และ farm/growlight/command) ---
# FARM_ENABLED=false  ถ้าไม่ใช้
# บอร์ดเดียวใน DB ปล่อยว่างได้ ถ้ามีหลายบอร์ดให้ใส่ devices.id หรือ MAC
FARM_DEVICE=
# ความยาวแผ่นวัดระดับน้ำ (ซม.) ใช้แปลง percent เป็น cm
WATER_PROBE_CM=4
# ชื่อใน actuators.name ที่เป็นไฟปลูก (PWM)
FARM_GROWLIGHT_ACTUATOR=grow_light_dimmer
